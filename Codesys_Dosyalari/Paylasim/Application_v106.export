      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Same command priorities; separate instances for Unity and CODESYS HMI.
CASE uiKomutKodu OF
2: uiOncelik := 1;
3: uiOncelik := 2;
5: uiOncelik := 3;
1: uiOncelik := 4;
4: uiOncelik := 5;
ELSE uiOncelik := 99;
END_CASE;
IF udiCevrimSayaci = UDINT#4294967295 THEN
    udiCevrimSayaci := 1;
ELSE
    udiCevrimSayaci := udiCevrimSayaci + 1;
END_IF;
IF xYeniKomut THEN
    uiSonKomutKodu := uiKomutKodu;
    uiSonOncelik := uiOncelik;
    udiSonKomutKimligi := udiKomutKimligi;
END_IF;
</Single>

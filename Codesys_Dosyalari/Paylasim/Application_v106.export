            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_CikisKontrolLD
VAR_INPUT
    // Diagnostic inputs: confirm scan updates without changing ladder logic.
    udiCevrimNo : UDINT;
    uiMakineDurumu : UINT;
	xCalismaIzni: BOOL;
	xBaglanti: BOOL;
	xVeriGecerli: BOOL;
	xAcilStop: BOOL;
